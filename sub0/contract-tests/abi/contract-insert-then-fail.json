{
  "id": "consera-contract-insert-then-fail-v1",
  "resource": "consera-contract-insert-then-fail",
  "tokenize": {
    "type": "JWT",
    "algorithm": "HS256",
    "encryption_key": "$ENV.CONTRACT_JWT_KEY"
  },
  "protected": {
    "provide_as": "Authorization",
    "extract_claims": ["id"]
  },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "payload_validation": [
        {
          "field": {
            "organizationId": {
              "type": "NUMBER"
            }
          }
        },
        {
          "field": {
            "mutationKey": {
              "type": "STRING"
            }
          },
          "min_length": 8,
          "max_length": 120
        }
      ],
      "sql_query": {
        "query": "SELECT consera_contract.contract_insert_then_fail($1, $2, $3)",
        "parameters": [
          "$PROTECTED.id",
          "$PAYLOAD.organizationId",
          "$PAYLOAD.mutationKey"
        ]
      }
    }
  ]
}
