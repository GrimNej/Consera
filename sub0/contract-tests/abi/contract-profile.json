{
  "id": "consera-contract-profile-v1",
  "resource": "consera-contract-profile",
  "tokenize": {
    "type": "JWT",
    "algorithm": "HS256",
    "encryption_key": "$ENV.CONTRACT_JWT_KEY"
  },
  "protected": {
    "provide_as": "Authorization",
    "extract_claims": ["id"]
  },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "sql_query": {
        "query": "SELECT id, email FROM consera_contract.contract_subjects WHERE id = $1",
        "parameters": ["$PROTECTED.id"]
      },
      "returnables": ["id", "email"]
    }
  ],
  "returnables": ["id", "email"]
}
