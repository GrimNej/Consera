{
  "id": "consera-contract-complete-job-v1",
  "resource": "consera-contract-complete-job",
  "tokenize": {
    "type": "JWT",
    "algorithm": "HS256",
    "encryption_key": "$ENV.CONTRACT_JWT_KEY"
  },
  "protected": {
    "provide_as": "Authorization",
    "extract_claims": ["id"]
  },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "payload_validation": [
        {
          "field": {
            "organizationId": {
              "type": "NUMBER"
            }
          }
        },
        {
          "field": {
            "jobKey": {
              "type": "STRING"
            }
          },
          "min_length": 8,
          "max_length": 120
        },
        {
          "field": {
            "leaseOwner": {
              "type": "STRING"
            }
          },
          "min_length": 8,
          "max_length": 120
        },
        {
          "field": {
            "leaseToken": {
              "type": "STRING"
            }
          },
          "min_length": 36,
          "max_length": 36
        },
        {
          "field": {
            "leaseGeneration": {
              "type": "NUMBER"
            }
          }
        }
      ],
      "sql_query": {
        "query": "SELECT * FROM consera_contract.contract_complete_job($1, $2, $3, $4, $5::uuid, $6)",
        "parameters": [
          "$PROTECTED.id",
          "$PAYLOAD.organizationId",
          "$PAYLOAD.jobKey",
          "$PAYLOAD.leaseOwner",
          "$PAYLOAD.leaseToken",
          "$PAYLOAD.leaseGeneration"
        ]
      },
      "returnables": ["completion_state"]
    }
  ],
  "returnables": ["completion_state"]
}
