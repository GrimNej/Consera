{
  "id": "consera-contract-runtime-secret-v1",
  "resource": "consera-contract-runtime-secret",
  "tokenize": {
    "type": "JWT",
    "algorithm": "HS256",
    "encryption_key": "$ENV.CONTRACT_JWT_KEY"
  },
  "protected": {
    "provide_as": "Authorization",
    "extract_claims": ["id"]
  },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "sql_query": {
        "query": "SELECT CASE WHEN length($1) >= 32 THEN 'available' ELSE 'missing' END AS runtime_secret_status FROM consera_contract.contract_subjects WHERE id = $2",
        "parameters": ["$ENV.CONTRACT_RUNTIME_PROBE", "$PROTECTED.id"]
      },
      "returnables": ["runtime_secret_status"]
    }
  ],
  "returnables": ["runtime_secret_status"]
}
